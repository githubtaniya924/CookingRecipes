@page
@model CookingRecipes.Pages.SearchResultsModel
@{
    ViewData["Title"] = "Search Results";
}

<div class="container mt-5">
    <h2 class="mb-4">Search Results for "@Model.Query"</h2>

    @if (!Model.Results.Any())
    {
        <p class="text-muted">No recipes found.</p>
    }
    else
    {
        <div class="row">
            @foreach (var recipe in Model.Results)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img src="@recipe.ImageUrl" class="card-img-top recipe-img" alt="@recipe.Title" />
                        <div class="card-body text-center">
                            <h5 class="card-title">@recipe.Title</h5>
                            <p class="card-text">@recipe.Cuisine</p>
                            <p><strong>Rating:</strong> @recipe.Rating</p>
                            <a asp-page="/RecipeDetails" asp-route-id="@recipe.Id" class="btn btn-success btn-sm">View Recipe</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
